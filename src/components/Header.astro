---
import { businessName, primaryNavLinks, drawerNavLinks } from '@/data/site'
import ThemeToggle from '@/components/ThemeToggle.astro'

const currentPath = Astro.url.pathname
const isCurrent = (href: string) => (href === '/' ? currentPath === '/' : currentPath.startsWith(href))
---

<header class="site-header on-navy">
  <div class="site-header__bar">
    <a href="/" class="site-header__brand">
      <img src="/logo-white.webp" alt="" width="46" height="28" class="site-header__brand-mark" />
      <span class="site-header__brand-divider" aria-hidden="true"></span>
      <span class="site-header__brand-name">{businessName}</span>
    </a>

    <nav aria-label="Primary" class="site-header__nav">
      <ul>
        {
          primaryNavLinks.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href="/payment/" class="site-header__utility" aria-current={isCurrent('/payment/') ? 'page' : undefined}
        >Payment</a
      >
      <ThemeToggle variant="compact" />
      <a href="/contact/" class="btn btn-primary site-header__cta">
        <span class="site-header__cta-full">Schedule a Consultation</span>
        <span class="site-header__cta-short">Consultation</span>
      </a>
    </div>

    <button
      type="button"
      class="site-header__menu-toggle"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-menu-toggle
    >
      <span class="sr-only">Menu</span>
      <span class="site-header__menu-icon" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
    </button>
  </div>

  <div class="site-header__drawer-backdrop" data-menu-backdrop></div>

  <div
    id="mobile-nav"
    class="site-header__drawer on-navy"
    data-menu
    role="dialog"
    aria-modal="true"
    aria-label="Site navigation"
    inert
  >
    <div class="site-header__drawer-top">
      <a href="/" class="site-header__drawer-brand" aria-label={`${businessName} — Home`}>
        <img src="/logo-white.webp" alt="" width="38" height="23" class="site-header__drawer-brand-mark" />
      </a>
      <button type="button" class="site-header__drawer-close" data-menu-close>
        <span class="sr-only">Close menu</span>
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>

    <nav aria-label="Primary" class="site-header__drawer-nav">
      <ul>
        {
          drawerNavLinks.map((link) => (
            <li>
              <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a href="/contact/" class="btn btn-primary site-header__drawer-cta">Schedule a Consultation</a>

    <div class="site-header__drawer-appearance">
      <ThemeToggle variant="labeled" />
    </div>

    <span class="site-header__drawer-divider" aria-hidden="true"></span>

    <img
      src="/footer-logo-white-470.webp"
      alt={businessName}
      width="470"
      height="177"
      class="site-header__drawer-logo"
    />
  </div>
</header>

<script src="@/scripts/menu.ts"></script>
<script src="@/scripts/theme.ts"></script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--surface-navy);
    color: var(--surface-navy-fg);
  }

  .site-header__bar {
    max-width: var(--content-width);
    margin: 0 auto;
    padding: var(--s4) var(--s5);
    display: flex;
    align-items: center;
    gap: var(--s6);
  }

  .site-header__brand {
    display: flex;
    align-items: center;
    gap: var(--s3);
    color: #fff;
    text-decoration: none;
    flex-shrink: 0;
  }

  .site-header__brand-mark {
    display: block;
    flex-shrink: 0;
  }

  .site-header__brand-divider {
    display: block;
    width: 1px;
    height: 24px;
    background: var(--surface-navy-rule);
  }

  .site-header__brand-name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.1875rem;
    line-height: 1.05;
    white-space: nowrap;
  }

  .site-header__nav {
    flex: 1;
    min-width: 0;
  }

  .site-header__nav ul {
    display: flex;
    gap: var(--s5);
    list-style: none;
    margin: 0;
    padding: 0;
    justify-content: center;
  }

  .site-header__nav a {
    display: inline-block;
    padding: 0.35rem 0.1rem;
    color: var(--surface-navy-fg);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: border-color var(--transition-fast);
  }

  .site-header__nav a:hover,
  .site-header__nav a:focus-visible {
    border-bottom-color: var(--surface-navy-accent);
  }

  .site-header__nav a[aria-current='page'] {
    border-bottom-color: var(--gold);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--s4);
    flex-shrink: 0;
  }

  /* Payment: one of the most-visited pages (returning clients), so it gets
     the exact same treatment as the primary nav links — only its position
     on the right differs. The gold CTA beside it stays the one dominant
     action. */
  .site-header__utility {
    display: inline-block;
    padding: 0.35rem 0.1rem;
    color: var(--surface-navy-fg);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9375rem;
    white-space: nowrap;
    border-bottom: 2px solid transparent;
    transition: border-color var(--transition-fast);
  }

  .site-header__utility:hover,
  .site-header__utility:focus-visible {
    border-bottom-color: var(--surface-navy-accent);
  }

  .site-header__utility[aria-current='page'] {
    border-bottom-color: var(--gold);
  }

  .site-header__cta-short {
    display: none;
  }

  .site-header__menu-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    background: transparent;
    border: 1px solid var(--surface-navy-rule);
    color: #fff;
    border-radius: 4px;
    padding: var(--s2) var(--s3);
    cursor: pointer;
  }

  .site-header__menu-icon {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 20px;
  }

  .site-header__menu-icon span {
    display: block;
    height: 2px;
    background: currentColor;
    border-radius: 1px;
  }

  /* Wide desktop and laptop (>=1300px): full treatment. */
  @media (min-width: 1300px) {
    .site-header__bar {
      gap: var(--s7);
    }
  }

  /* Condensed landscape-tablet / narrow-laptop (900–1299px):
     reduced spacing and a shortened CTA so the nav, Payment, theme control,
     and CTA all stay visible without wrapping or colliding. */
  @media (max-width: 1299px) {
    .site-header__bar {
      gap: var(--s4);
      padding: var(--s3) var(--s4);
    }

    .site-header__nav ul {
      gap: var(--s4);
    }

    .site-header__cta-full {
      display: none;
    }

    .site-header__cta-short {
      display: inline;
    }

    .site-header__cta {
      padding: 0.7rem 1rem;
    }
  }

  /* Portrait-tablet and mobile (<900px): drawer-nav toggle button shown. */
  @media (max-width: 899px) {
    .site-header__nav,
    .site-header__actions {
      display: none;
    }

    .site-header__menu-toggle {
      display: inline-flex;
      margin-left: auto;
    }
  }

  /* Mobile/tablet drawer — replaces the old full-width expanded disclosure
     menu. Positioning is unconditional (not gated to <900px): the toggle
     that opens it only exists below 900px, and `inert` (toggled in
     menu.ts) keeps it out of the tab order and accessibility tree whenever
     it's closed, so there's no need to also fight it out of the layout
     with a breakpoint — one fewer place for the two to drift out of sync. */
  .site-header__drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(15, 20, 32, 0.55);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--transition-fast);
    z-index: 60;
  }

  .site-header__drawer-backdrop[data-open] {
    opacity: 1;
    pointer-events: auto;
  }

  .site-header__drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    width: min(300px, 85vw);
    display: flex;
    flex-direction: column;
    background: var(--surface-navy);
    color: var(--surface-navy-fg);
    padding: var(--s5);
    box-shadow: -8px 0 24px rgba(0, 0, 0, 0.25);
    overflow-y: auto;
    transform: translateX(100%);
    visibility: hidden;
    /* visibility flips to hidden only after the slide-out finishes (matches
       the transform duration) — keeps it out of the accessibility tree and
       out of visibility-based automated checks while closed, without losing
       the animated slide (display:none can't be transitioned). */
    transition:
      transform 0.25s ease,
      visibility 0s linear 0.25s;
    z-index: 61;
  }

  .site-header__drawer[data-open] {
    transform: translateX(0);
    visibility: visible;
    transition: transform 0.25s ease;
  }

  .site-header__drawer-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s4);
    margin-bottom: var(--s4);
  }

  .site-header__drawer-brand {
    display: flex;
    align-items: center;
    gap: var(--s3);
    color: #fff;
    text-decoration: none;
    min-width: 0;
  }

  .site-header__drawer-brand-mark {
    display: block;
    flex-shrink: 0;
  }

  .site-header__drawer-close {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-width: 44px;
    min-height: 44px;
    background: transparent;
    border: 1px solid var(--surface-navy-rule);
    color: #fff;
    border-radius: 4px;
  }

  .site-header__drawer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }

  .site-header__drawer-nav a {
    display: flex;
    align-items: center;
    min-height: 48px;
    padding: var(--s3) 0;
    color: #fff;
    text-decoration: none;
    font-weight: 600;
    font-size: 1.0625rem;
    border-bottom: 1px solid var(--surface-navy-rule);
  }

  .site-header__drawer-nav a:hover,
  .site-header__drawer-nav a:focus-visible {
    color: var(--surface-navy-accent);
  }

  .site-header__drawer-nav a[aria-current='page'] {
    color: var(--gold);
  }

  .site-header__drawer-cta {
    width: 100%;
    margin-top: var(--s5);
  }

  .site-header__drawer-divider {
    display: block;
    height: 1px;
    background: var(--surface-navy-rule);
    margin: var(--s6) 0 var(--s5);
  }

  /* The drawer's main branding moment — the full logo (mark + firm name),
     sized comfortably rather than filling the drawer's width, and centered
     since nothing else in the drawer shares a left edge with it. */
  .site-header__drawer-logo {
    display: block;
    width: 100%;
    max-width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .site-header__drawer-appearance {
    margin-top: var(--s5);
  }

  /* Legacy phones with very short viewports (e.g. iPhone SE in landscape,
     older Android devices) can't fit the full-height drawer content above
     the fold — drop the trailing brand moment (divider + logo) first since
     it's decorative, not navigational. */
  @media (max-height: 659px) {
    .site-header__drawer-divider,
    .site-header__drawer-logo {
      display: none;
    }
  }
</style>
