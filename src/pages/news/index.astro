---
import BaseLayout from '@/layouts/BaseLayout.astro'
import { businessName } from '@/data/site'
import { sortedNewsArticles, newsArticlePath, formatNewsDate } from '@/data/news'
import { webPageJsonLd } from '@/lib/json-ld'

const title = 'News & Announcements'
const description = `Updates, press releases, and other news from ${businessName}.`

const jsonLd = [
  webPageJsonLd({
    path: '/news/',
    name: `${title} | ${businessName}`,
    description,
    breadcrumbs: [
      { name: 'Home', path: '/' },
      { name: 'News', path: '/news/' },
    ],
    pageType: 'CollectionPage',
  }),
]
---

<BaseLayout title={title} description={description} path="/news/" jsonLd={jsonLd}>
  <section class="page-section page-section--narrow news-index">
    <div class="page-hero">
      <span class="eyebrow">{businessName}</span>
      <h1>{title}</h1>
      <p class="lead">Updates, press releases, and other news</p>
    </div>

    {
      sortedNewsArticles.length > 0 ? (
        <ul class="news-list">
          {sortedNewsArticles.map((article) => (
            <li class="news-list__item">
              <article>
                <p class="news-list__meta">
                  <span class="news-list__type">{article.type}</span>
                  <span class="news-list__sep" aria-hidden="true">
                    ·
                  </span>
                  <time datetime={article.datePublished}>{formatNewsDate(article.datePublished)}</time>
                </p>
                <h2 class="news-list__title">
                  <a href={newsArticlePath(article)}>{article.title}</a>
                </h2>
                <p class="news-list__summary">{article.summary}</p>
                {/* Visual cue only: the headline link above is stretched
                    over the whole item, so this is a styled span (same
                    .link-editorial markup as Home's "See areas of practice")
                    rather than a second, redundant tab stop. */}
                <span class="link-editorial news-list__cta" aria-hidden="true">
                  Read {article.type.toLowerCase()}<span class="link-editorial__arrow">→</span>
                </span>
              </article>
            </li>
          ))}
        </ul>
      ) : (
        <p class="news-list__empty">No news yet — check back soon.</p>
      )
    }
  </section>
</BaseLayout>

<style>
  .news-list {
    list-style: none;
    margin: var(--s7) 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  /* Whole item is the click target: the headline link's ::after is stretched
     over it (see .news-list__title a::after below). */
  .news-list__item {
    position: relative;
    padding: var(--s6) 0;
    border-bottom: 1px solid var(--rule);
  }

  /* Focus ring drawn around the whole clickable item instead of just the
     headline text, since the item is the actual target. */
  .news-list__item:has(.news-list__title a:focus-visible) {
    outline: 2px solid var(--focus-ring);
    outline-offset: 4px;
    border-radius: 2px;
  }

  /* Small-caps metadata line — same type treatment as .eyebrow: content
     type first in the eyebrow's gold-ink, date after it in the soft body
     color. Article pages use the same order and colors. */
  .news-list__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--s2);
    margin: 0 0 var(--s3);
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-soft);
    font-variant-numeric: tabular-nums;
  }

  .news-list__type {
    color: var(--gold-ink);
  }

  .news-list__title {
    font-size: clamp(1.375rem, 1.25rem + 0.5vw, 1.625rem);
    line-height: 1.25;
    margin-bottom: var(--s3);
  }

  /* Headline link stays plain heading text — the "Read …" cue below is
     the item's single hover/focus signal. */
  .news-list__title a {
    color: var(--fg);
    text-decoration: none;
  }

  .news-list__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .news-list__title a:focus-visible {
    outline: none;
  }

  /* Hovering anywhere on the item (or focusing its link) triggers the
     "Read …" cue's underline + arrow nudge — the same behavior as Home's
     "See areas of practice →". */
  .news-list__item:hover .news-list__cta,
  .news-list__item:has(.news-list__title a:focus-visible) .news-list__cta {
    text-decoration-color: var(--gold);
  }

  .news-list__item:hover .news-list__cta .link-editorial__arrow,
  .news-list__item:has(.news-list__title a:focus-visible) .news-list__cta .link-editorial__arrow {
    transform: translateX(3px);
  }

  .news-list__summary {
    color: var(--fg-soft);
    margin-bottom: var(--s4);
  }

  .news-list__empty {
    margin-top: var(--s7);
    color: var(--fg-soft);
  }

  /* The intro centers below 900px via .page-hero; the list itself stays
     left aligned, like every other page's body content. */
</style>
