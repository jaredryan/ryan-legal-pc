---
import type { GetStaticPaths } from 'astro'
import BaseLayout from '@/layouts/BaseLayout.astro'
import {
  newsArticles,
  newsArticlePath,
  newsArticleDescription,
  formatNewsDate,
  type NewsArticle,
} from '@/data/news'
import { webPageJsonLd, legalServiceJsonLd, newsArticleJsonLd } from '@/lib/json-ld'

export const getStaticPaths = (() =>
  newsArticles.map((article) => ({ params: { slug: article.slug }, props: { article } }))) satisfies GetStaticPaths

interface Props {
  article: NewsArticle
}

// Layout: width, padding, and type rhythm follow About's narrow profile
// column (.about-narrow: --content-narrow); the header uses the same
// meta/title/summary styles as the /news/ list (.news-* in global.css).
// Unlike other pages' intros, the header deliberately skips .page-hero's
// <900px centering: everything stays left-aligned at every width, the way
// news outlets set articles and the way the /news/ list entries already read.
const { article } = Astro.props
const path = newsArticlePath(article)
const description = newsArticleDescription(article)
const pdfLabel = article.pdfLabel ?? `View original ${article.type.toLowerCase()} (PDF)`
const articleLd = newsArticleJsonLd(article)

const jsonLd = [
  legalServiceJsonLd(),
  articleLd,
  webPageJsonLd({
    path,
    name: article.title,
    description,
    breadcrumbs: [
      { name: 'Home', path: '/' },
      { name: 'News', path: '/news/' },
      { name: article.title, path },
    ],
    mainEntity: [{ '@id': articleLd['@id'] }],
  }),
]
---

<BaseLayout
  title={article.title}
  description={description}
  path={path}
  jsonLd={jsonLd}
  social={{
    title: article.ogTitle ?? article.title,
    description: article.ogDescription ?? description,
    image: article.image,
    type: 'article',
    publishedTime: article.datePublished,
    modifiedTime: article.dateModified,
  }}
>
  <div class="page-section page-section--narrow news-article">
    <p class="news-article__up">
      <a href="/news/" class="news-article__back" aria-label="Back to News">
        <span class="link-editorial__arrow" aria-hidden="true">←</span>News
      </a>
    </p>

    <article>
    <header class="news-article__header">
      <p class="news-meta news-article__meta">
        <span class="news-meta__type">{article.type}</span>
        <span aria-hidden="true">·</span>
        <time datetime={article.datePublished}>{formatNewsDate(article.datePublished)}</time>
      </p>
      <h1 class="news-title">{article.title}</h1>
      <p class="news-summary">{article.summary}</p>
      {
        article.dateModified && (
          <p class="news-article__updated">
            Updated <time datetime={article.dateModified}>{formatNewsDate(article.dateModified)}</time>
          </p>
        )
      }
      {
        article.pdfUrl && (
          <a href={article.pdfUrl} type="application/pdf" class="link-editorial news-article__pdf">
            {pdfLabel}<span class="link-editorial__arrow" aria-hidden="true">→</span>
          </a>
        )
      }
    </header>

    <div class="news-article__body">
      {
        article.body.map((block) =>
          typeof block === 'string' ? (
            <p>{block}</p>
          ) : 'html' in block ? (
            <p set:html={block.html} />
          ) : 'heading' in block ? (
            <h2 class="news-article__subhead">{block.heading}</h2>
          ) : (
            <p class="news-article__note">{block.note}</p>
          ),
        )
      }
      {
        /* Every item with a PDF repeats the link at the end of the text, so
           readers who finish the web version don't have to scroll back up.
           Excerpted items (e.g. a complaint's introduction) add a short note
           above it pointing to the full document. */
        article.pdfUrl && (
          <div class="news-article__continued">
            {article.excerptNote && <p>{article.excerptNote}</p>}
            <a href={article.pdfUrl} type="application/pdf" class="link-editorial">
              {pdfLabel}<span class="link-editorial__arrow" aria-hidden="true">→</span>
            </a>
          </div>
        )
      }
    </div>

    <footer class="news-article__footer">
      <a href="/news/" class="link-editorial news-article__back">
        <span class="link-editorial__arrow" aria-hidden="true">←</span>Back to News
      </a>
    </footer>
    </article>
  </div>
</BaseLayout>

<style>
  .news-article__up {
    margin: 0 0 var(--s6);
    font-size: 0.9375rem;
  }

  /* Quiet at rest (soft body color, no underline); the same transparent →
     gold underline as .link-editorial on hover/focus. */
  .news-article__up a {
    color: var(--fg-soft);
    font-weight: 600;
    text-decoration-line: underline;
    text-decoration-color: transparent;
    text-decoration-thickness: 2px;
    text-underline-offset: calc(0.18em + 1.5px);
    transition:
      color var(--transition-fast),
      text-decoration-color var(--transition-fast);
  }

  .news-article__up a:hover,
  .news-article__up a:focus-visible {
    color: var(--fg);
    text-decoration-color: var(--gold);
  }

  .news-article__updated {
    color: var(--fg-soft);
    font-size: 0.9375rem;
  }

  .news-article__pdf {
    display: inline-block;
  }

  /* A plain hairline between header and body — structural, so it uses the
     neutral --rule rather than the gold .section-rule mark, which means
     "a new section begins" elsewhere on the site. */
  .news-article__body {
    margin-top: var(--s6);
    padding-top: var(--s6);
    border-top: 1px solid var(--rule);
  }

  .news-article__subhead {
    font-size: clamp(1.375rem, 1.25rem + 0.5vw, 1.625rem);
    margin-top: var(--s6);
  }

  /* Footnote-style text carried over from the source document. */
  .news-article__note {
    font-size: 0.9375rem;
    color: var(--fg-soft);
  }

  /* Closing pointer to the full PDF when the body is only an excerpt —
     separated by the same neutral hairline as the header/body break. */
  .news-article__continued {
    margin-top: var(--s6);
    padding-top: var(--s6);
    border-top: 1px solid var(--rule);
  }

  .news-article__continued p {
    color: var(--fg-soft);
  }

  .news-article__footer {
    margin-top: var(--s7);
  }

  /* Leading arrow: flips the global trailing-arrow margin (see
     .link-editorial__arrow in global.css) to the other side. */
  .news-article__back .link-editorial__arrow {
    margin-left: 0;
    margin-right: 0.3em;
  }

  /* Left-pointing arrow nudges left, not right, on hover/focus. */
  .news-article__back:hover .link-editorial__arrow,
  .news-article__back:focus-visible .link-editorial__arrow {
    transform: translateX(-3px);
  }
</style>
